{
  "name": "session-lens",
  "version": "0.1.3-l0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "probe:host-isolation": "node scripts/host-thread-isolation-probe.mjs",
    "check": "pnpm build && pnpm test",
    "package:local": "pnpm check && pnpm smoke && node scripts/package-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
